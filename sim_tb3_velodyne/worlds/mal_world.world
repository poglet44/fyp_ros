
<!-- ### sdf is standard definition of worlds in gazebo -->
<sdf version='1.5'>
  <world name='my2ndworld'>
    <!-- A global light source -->
    <include>

<!-- ### Model which comes with gazebo e.g sun -->
      <uri>model://sun</uri>
    </include>

    <!-- A ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

<!-- ### The launch file 'includes' this file, 'First_world'. Now this file is including the sdf files which are used to make the environment, models, and even robots (but in our case a urdf was used to make a robot).
# This file can overwite some variables (which are called 'elements' in xml) already defined in the sdf file, like 'static', which I have kept to true in this case. -->
  
    <!-- Load world -->
    <include>
<!-- ### it used to be: model://turtlebot3_world -->
      <uri>model://my2ndmodel</uri>
      <static>1</static> 
    </include>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
 <!--  ### note the pose line below moves the location of the object. I could also add this line under the sun model to adjust the location of the sun away from its default pose -->
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>0.8 0.0 12.0 0 1.5708 0</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
  
    <model name="complex_doorway_blocker_1">
      <static>true</static>
      <pose>0.068 -43.103275 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.230970 10.9932 7.61953</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.230970 10.9932 7.61953</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <model name="complex_doorway_blocker_2">
      <static>true</static>
      <pose>60.048096 -34.320667 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.335726 11.550700 7.578910</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.335726 11.550700 7.578910</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <model name="complex_doorway_blocker_3">
      <static>true</static>
      <pose>9.534438 -20.813101 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.011890 1.178190 5.260690</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.011890 1.178190 5.260690</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <model name="room_blocker">
      <static>true</static>
      <pose>27.353083 -14.194550 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>5.5524210 8.07860 8.287240</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>5.5524210 8.07860 8.287240</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

</world>
</sdf>
